  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rgvc.Api\Rgvc.Api.csproj" />
  </ItemGroup>

</Project>
